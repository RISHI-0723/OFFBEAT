# ---------- Server (private — never prefix with VITE_) ----------
PORT=8787
# Required in production. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Production database: Supabase TRANSACTION POOLER URI (Project > Connect > Transaction pooler, port 6543).
# Contains the database password: keep it ONLY in Vercel env vars or a git-ignored file (e.g. .env.supabase). Never VITE_-prefixed.
# Format: postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Optional. Auto-selected: postgres when DATABASE_URL is set; otherwise PGlite (local dev only). Production without DATABASE_URL fails fast
# unless DB_DRIVER=pglite is set explicitly (single container with a persistent disk, e.g. Docker).
DB_DRIVER=
# Directory for the embedded Postgres (PGlite) data. Leave empty for in-memory.
DATA_DIR=./data/pg
# Monad Testnet (verified against docs.monad.xyz)
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143
EXPLORER_URL=https://testnet.monadvision.com
# Filled in after `npm run chain:deploy`
REWARD_POOL_ADDRESS=
# Dedicated TESTNET-ONLY deployer wallet, used only by local scripts (chain:deploy, chain:seed). Never commit.
DEPLOYER_PRIVATE_KEY=
# Demo curator wallets used only by chain:seed (testnet-only throwaway keys)
DEMO_CURATOR_A_PRIVATE_KEY=
DEMO_CURATOR_B_PRIVATE_KEY=
# Set to a long random value to enable POST /api/admin/reset (disabled when empty)
DEMO_ADMIN_TOKEN=
# Leave unset in production. Even with DEMO_ADMIN_TOKEN set, /api/admin/reset (TRUNCATE) stays disabled in production unless this is 1.
ALLOW_PROD_RESET=
